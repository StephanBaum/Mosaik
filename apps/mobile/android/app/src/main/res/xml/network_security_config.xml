<?xml version="1.0" encoding="utf-8"?>
<!-- System CAs only: no cleartext, no user-installed CAs (ADR-0091). The Rust core collects its trust
     anchors from the platform trust manager under this configuration. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
