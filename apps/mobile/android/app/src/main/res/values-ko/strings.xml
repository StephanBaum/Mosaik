<resources>
  <string name="l10n_locale">ko</string>
  <string name="error_accountExists">이 기기에는 이미 Mosaic 계정이 있어요. 대신 잠금을 해제하세요.</string>
  <string name="error_appNotLinked">이 앱은 저장된 웹사이트에 연결되어 있지 않아요. 먼저 Mosaic에서 연결한 다음 다시 시도하세요.</string>
  <string name="error_appNotVerified">이 앱은 해당 웹사이트에 대해 확인되지 않아서 Mosaic이 패스키를 사용하지 않아요. 대신 브라우저에서 웹사이트를 사용하세요.</string>
  <string name="error_assetLinksUnavailable">이 앱이 해당 웹사이트에 속하는지 Mosaic이 확인할 수 없었어요. 연결을 확인한 다음 다시 시도하세요.</string>
  <string name="error_busy">Mosaic이 마지막 단계를 아직 마무리하고 있어요. 잠시 기다린 다음 다시 시도하세요.</string>
  <string name="error_emptyPassword">마스터 비밀번호가 비어 있어요. 계속하려면 입력하세요.</string>
  <string name="error_folderLinkExpired">로그인에 시간이 너무 오래 걸렸어요. 다시 시작하세요.</string>
  <string name="error_folderLinkInvalid">로그인이 작동하지 않았거나 취소되었어요. 다시 시작하세요.</string>
  <string name="error_folderNotFound">Mosaic이 그 폴더를 찾을 수 없거나 Mosaic 폴더가 아니에요. 컴퓨터가 동기화하는 폴더를 선택하세요.</string>
  <string name="error_folderProviderSignedOut">클라우드 서비스가 로그인을 종료했거나 거부했어요. 계속 동기화하려면 다시 로그인하세요.</string>
  <string name="error_folderProviderUnsupported">이 휴대폰에서는 이 계정의 클라우드 폴더에 접근할 수 없어요. 폴더 제공업체에 다시 로그인하거나 데스크톱을 사용하세요.</string>
  <string name="error_folderServerTlsTooOld">이 서버는 보안 연결을 하기에는 너무 오래되었어요. Mosaic은 TLS 1.3이 필요해요. 서버 운영자에게 업데이트를 요청하세요.</string>
  <string name="error_folderStorageFull">클라우드 저장 공간이 가득 찼어요. 그곳에서 공간을 확보한 다음 다시 동기화하세요.</string>
  <string name="error_foreignFrame">이 입력란은 페이지에 삽입된 다른 사이트의 것이라 Mosaic이 입력하지 않아요.</string>
  <string name="error_insecureOrigin">이 페이지는 보안 연결을 사용하지 않아서 Mosaic이 입력하지 않아요. 페이지의 https 버전을 여세요.</string>
  <string name="error_internal">예기치 않은 문제로 이 작업이 중단되었어요. 다시 시도하고, 계속되면 Mosaic을 다시 시작하세요.</string>
  <string name="error_invalidInput">입력한 내용 중 올바르지 않은 것이 있어요. 입력 내용을 확인하고 다시 시도하세요.</string>
  <string name="error_itemTypeNotAllowed">이 보관함에는 일회용 코드만 넣을 수 있어요.</string>
  <string name="error_locked">Mosaic이 잠겨 있어요. 계속하려면 잠금을 해제하세요.</string>
  <string name="error_noAccount">이 휴대폰에는 아직 Mosaic이 설정되어 있지 않아요. Mosaic을 열어 설정하세요.</string>
  <string name="error_noMatch">이 앱이나 웹사이트의 로그인이 Mosaic에 없어요. Mosaic을 열어 추가하세요.</string>
  <string name="error_notEnoughMemory">이 기기에는 보관함을 열 만큼 여유 메모리가 없어요. 다른 앱을 닫은 다음 다시 시도하세요.</string>
  <string name="error_notFound">이 항목은 더 이상 없어요. 다른 기기에서 삭제되었을 수 있어요.</string>
  <string name="error_otpKeyInvalid">올바르지 않은 키예요. 영문자 A~Z와 숫자 2~7만 사용해요. 오타가 없는지 확인하세요.</string>
  <string name="error_otpQrInvalid">이 설정 코드는 Mosaic이 지원하지 않는 설정을 사용해요. 대신 설정 키를 입력하세요.</string>
  <string name="error_otpQrMigration">Google Authenticator 내보내기 코드예요. Mosaic은 아직 읽을 수 없어요. 각 계정을 해당 사이트에서 다시 설정하거나 설정 키를 입력하세요.</string>
  <string name="error_otpQrMultiple">설정 코드가 둘 이상 보여요. 원하는 것 하나만 표시한 다음 다시 시도하세요.</string>
  <string name="error_otpQrNotOtp">이 QR 코드는 2단계 인증 설정 코드가 아니에요. 사이트의 2단계 인증 설정 페이지에서 코드를 찾으세요.</string>
  <string name="error_otpUriInvalid">올바른 otpauth:// 링크가 아니에요. 링크 전체를 다시 복사하세요.</string>
  <string name="error_passkeyExcluded">Mosaic에 이 계정의 패스키가 이미 있어요. 대신 그것으로 로그인하세요.</string>
  <string name="error_passkeyNotFound">이 웹사이트의 패스키가 Mosaic에 없어요. 다른 방법으로 로그인하세요.</string>
  <string name="error_passkeySessionExpired">이 패스키 요청이 만료되었어요. 앱에서 다시 시작하세요.</string>
  <string name="error_passkeyUnsupportedAlgorithm">이 웹사이트는 Mosaic이 아직 만들 수 없는 유형의 패스키가 필요해요. 다른 로그인 방법을 선택하세요.</string>
  <string name="error_passwordInApp">여기에서는 마스터 비밀번호로 잠금을 해제할 수 없어요. Mosaic 앱을 열어 그곳에서 잠금을 해제하세요.</string>
  <string name="error_passwordRequired">이번에는 마스터 비밀번호를 입력하세요. 그 후에는 빠른 잠금 해제가 다시 작동해요.</string>
  <string name="error_qrNotFound">그 이미지에서 QR 코드를 찾지 못했어요. 더 선명한 사진으로 다시 시도하세요.</string>
  <string name="error_quickUnlockExpired">빠른 잠금 해제가 만료되었어요. 마스터 비밀번호로 잠금을 해제한 다음 설정에서 다시 켜세요.</string>
  <string name="error_quickUnlockInvalidated">이 기기에서 빠른 잠금 해제가 작동하지 않아 꺼졌어요. 마스터 비밀번호로 잠금을 해제하세요.</string>
  <string name="error_reauthRequired">이 변경에는 마스터 비밀번호가 필요해요. 확인하려면 입력하세요.</string>
  <string name="error_rpIdInvalid">이 요청의 웹사이트 이름이 올바르지 않아요. 취소하고 다시 시작하세요.</string>
  <string name="error_secretKeyMalformed">비밀 키가 아니에요. 내 비밀 키는 “M1-”로 시작하며 비상 키트에 있어요.</string>
  <string name="error_secretKeyMistyped">이 비밀 키에 오타가 있어요. 비상 키트와 한 글자씩 비교해 보세요.</string>
  <string name="error_secretKeyRequired">이 기기에는 비밀 키가 없어요. 비상 키트에서 입력하세요.</string>
  <string name="error_setupCodeInvalid">이 설정 코드가 올바르지 않거나 만료되었어요. 컴퓨터에서 새로 만든 다음 다시 스캔하세요.</string>
  <string name="error_storageUnavailable">Mosaic이 이 기기의 보안 저장소에 접근할 수 없었어요. 휴대폰을 다시 시작한 다음 시도하세요.</string>
  <string name="error_storeInUse">이 휴대폰의 다른 곳에서 Mosaic이 사용 중이에요. 잠시 기다린 다음 다시 시도하세요.</string>
  <string name="error_storeUnavailable">Mosaic이 이 기기에서 보관함 파일을 열 수 없었어요. 디스크를 사용할 수 있고 여유 공간이 있는지 확인한 다음 Mosaic을 다시 시작하세요.</string>
  <string name="error_syncAccountRekeyed">다른 기기에서 계정의 키를 갱신했어요. 계속하려면 새 비상 키트의 비밀 키를 사용하세요.</string>
  <string name="error_syncFailed">Mosaic이 동기화할 수 없었어요. 연결을 확인한 다음 다시 시도하세요.</string>
  <string name="error_syncFolderDamaged">이 폴더의 일부 동기화 파일이 손상되었어요. 클라우드 서비스가 동기화를 마치게 하거나 백업에서 폴더를 복원한 다음 다시 시도하세요.</string>
  <string name="error_syncFolderNoAccount">이 폴더에는 이 계정의 동기화 데이터가 없어요. 다른 기기가 동기화하는 폴더를 선택하세요.</string>
  <string name="error_syncHandoffExpired">브라우저 단계의 시간이 지났어요. 다시 시작하세요.</string>
  <string name="error_syncNotConfigured">이 기기에는 아직 동기화가 설정되어 있지 않아요. 먼저 설정에서 설정하세요.</string>
  <string name="error_syncPasswordChanged">서버나 폴더에서 마스터 비밀번호가 변경되었어요. 아래에 새 비밀번호를 입력하세요.</string>
  <string name="error_syncPasswordRollback">폴더에 이 휴대폰이 아는 것보다 오래된 마스터 비밀번호가 있어요. 폴더와 클라우드 서비스를 확인하세요.</string>
  <string name="error_syncRateLimited">시도가 너무 많아요. 몇 분 기다린 다음 다시 시도하세요.</string>
  <string name="error_syncServerIncompatible">이 서버는 내 Mosaic과 맞지 않는 버전으로 실행되고 있어요. Mosaic을 업데이트하거나 서버 소유자에게 업데이트를 요청하세요.</string>
  <string name="error_syncServerInsecure">Mosaic은 중간에서 아무도 데이터를 읽거나 바꿀 수 없도록 https로만 서버에 연결해요. https:// 주소를 사용하세요.</string>
  <string name="error_syncServerInvalid">Mosaic 서버처럼 보이지 않아요. 주소를 확인하세요. https://sync.example.com 같은 형태여야 해요.</string>
  <string name="error_syncServerMismatch">이 계정이 동기화하는 서버가 아니에요. 주소를 확인하세요.</string>
  <string name="error_syncServerUnreachable">Mosaic이 서버에 연결할 수 없었어요. 주소와 인터넷 연결을 확인한 다음 다시 시도하세요.</string>
  <string name="error_syncSignedOut">서버가 이 기기를 로그아웃시켰어요. 계속 동기화하려면 다시 로그인하세요. 변경 사항은 이 기기에 안전하게 있어요.</string>
  <string name="error_syncTwoFactorInvalid">코드가 올바르지 않거나 만료되었어요. 인증 앱의 현재 6자리 코드를 입력하세요.</string>
  <string name="error_syncTwoFactorRequired">이 동기화 계정에는 인증 앱의 코드가 필요해요. 6자리 코드를 입력하세요.</string>
  <string name="error_vaultUnavailable">지금은 이 보관함을 열 수 없어요. 동기화한 다음 다시 시도하거나 Mosaic을 다시 잠금 해제하세요.</string>
  <string name="error_wrongCredentials">마스터 비밀번호 또는 비밀 키가 올바르지 않아요. 오타와 키보드 언어를 확인한 다음 다시 시도하세요.</string>
