          "stringUnit" : {
            "state" : "translated",
            "value" : "This vault holds one-time codes only."
          }
        }
      }
    },
    "error.locked" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic ist gesperrt. Entsperre es, um weiterzumachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic is locked. Unlock it to continue."
          }
        }
      }
    },
    "error.noAccount" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät gibt es noch kein Konto. Erstelle eins oder melde dich mit deinem Emergency Kit an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's no account on this device yet. Create one, or sign in with your Emergency Kit."
          }
        }
      }
    },
    "error.noMatch" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic hat keinen Login für diese App oder Website. Öffne Mosaic, um einen hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic has no login for this app or website. Open Mosaic to add one."
          }
        }
      }
    },
    "error.notEnoughMemory" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät ist nicht genug freier Speicher, um deinen Tresor zu entsperren. Schließe andere Apps und versuche es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device doesn't have enough free memory to unlock your vault. Close other apps and try again."
          }
        }
      }
    },
    "error.notFound" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diesen Eintrag gibt es nicht mehr. Vielleicht wurde er auf einem anderen Gerät gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That item no longer exists. It may have been deleted on another device."
          }
        }
      }
    },
    "error.otpKeyInvalid" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Schlüssel ist ungültig. Er besteht nur aus den Buchstaben A bis Z und den Ziffern 2 bis 7; prüf ihn auf Tippfehler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This key isn't valid. It uses only the letters A to Z and the digits 2 to 7; check for typos."
          }
        }
      }
    },
    "error.otpQrInvalid" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Einrichtungscode nutzt Einstellungen, die Mosaic nicht unterstützt. Gib stattdessen den Einrichtungsschlüssel ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This setup code uses settings Mosaic doesn't support. Enter the setup key instead."
          }
        }
      }
    },
    "error.otpQrMigration" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist ein Exportcode aus Google Authenticator, den Mosaic noch nicht lesen kann. Richte jedes Konto auf seiner Website neu ein oder gib den Einrichtungsschlüssel ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a Google Authenticator export code, which Mosaic can't read yet. Set up each account again on its site, or enter its setup key."
          }
        }
      }
    },
    "error.otpQrMultiple" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr als ein Einrichtungscode ist sichtbar. Zeig nur den gewünschten und versuch es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More than one setup code is visible. Show only the one you want, then try again."
          }
        }
      }
    },
    "error.otpQrNotOtp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
