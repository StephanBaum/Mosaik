    "mobile.reset.revokeDropbox" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Konto wurde entfernt. Mosaics Zugriff bei Dropbox konnten wir nicht beenden: Entferne ihn in Dropbox unter Einstellungen, Verbundene Apps."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account was removed. We could not end Mosaic's access at Dropbox: remove it in Dropbox under Settings, Connected apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitó la cuenta. No pudimos terminar el acceso de Mosaic en Dropbox: quítalo en Dropbox, en Ajustes, Aplicaciones conectadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte a été supprimé. Nous n’avons pas pu mettre fin à l’accès de Mosaic chez Dropbox : retirez-le dans Dropbox, sous Paramètres, Applications connectées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'account è stato rimosso. Non siamo riusciti a terminare l'accesso di Mosaic su Dropbox: rimuovilo in Dropbox, in Impostazioni, App collegate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを削除しました。Dropbox での Mosaic のアクセスを終了できませんでした。Dropbox の「設定」の「接続済みアプリ」から削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 제거했어요. Dropbox에서 Mosaic의 접근 권한을 종료하지 못했어요. Dropbox의 설정, 연결된 앱에서 직접 제거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het account is verwijderd. We konden de toegang van Mosaic bij Dropbox niet beëindigen: verwijder die in Dropbox onder Instellingen, Verbonden apps."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto zostało usunięte. Nie udało się zakończyć dostępu Mosaic w Dropbox: usuń go w Dropbox w Ustawienia, Połączone aplikacje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conta foi removida. Não foi possível encerrar o acesso do Mosaic no Dropbox: remova-o no Dropbox, em Configurações, Aplicativos conectados."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesap kaldırıldı. Mosaic’in Dropbox’taki erişimi sonlandırılamadı: Dropbox’ta Ayarlar, Bağlı uygulamalar altından kaldırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "账户已移除。我们无法在 Dropbox 上终止 Mosaic 的访问权限：请在 Dropbox 的“设置”“已连接的应用”中移除它。"
          }
        }
      }
    },
    "mobile.reset.revokeWebdav" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Konto wurde entfernt. Das App-Passwort auf deinem Server konnten wir nicht löschen: Entferne es dort unter Einstellungen, Sicherheit, Geräte und Sitzungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account was removed. We could not delete the app password on your server: remove it there under Settings, Security, Devices and sessions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitó la cuenta. No pudimos eliminar la contraseña de aplicación en tu servidor: quítala allí, en Ajustes, Seguridad, Dispositivos y sesiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte a été supprimé. Nous n’avons pas pu supprimer le mot de passe d’application sur votre serveur : retirez-le là-bas, sous Paramètres, Sécurité, Appareils et sessions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'account è stato rimosso. Non siamo riusciti a eliminare la password per app sul tuo server: rimuovila lì, in Impostazioni, Sicurezza, Dispositivi e sessioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを削除しました。サーバー上のアプリパスワードを削除できませんでした。サーバーの「設定」、「セキュリティ」、「デバイスとセッション」から削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 제거했어요. 서버의 앱 비밀번호를 삭제하지 못했어요. 서버의 설정, 보안, 기기 및 세션에서 직접 제거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het account is verwijderd. We konden het app-wachtwoord op je server niet verwijderen: verwijder het daar onder Instellingen, Beveiliging, Apparaten en sessies."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto zostało usunięte. Nie udało się usunąć hasła aplikacji na Twoim serwerze: usuń je tam w Ustawienia, Bezpieczeństwo, Urządzenia i sesje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conta foi removida. Não foi possível excluir a senha de app no seu servidor: remova-a lá, em Configurações, Segurança, Dispositivos e sessões."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesap kaldırıldı. Sunucunuzdaki uygulama parolası silinemedi: orada Ayarlar, Güvenlik, Aygıtlar ve oturumlar altından kaldırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "账户已移除。我们无法删除你服务器上的应用专用密码：请在那里的“设置”“安全”“设备和会话”中移除它。"
          }
        }
      }
    },
