    "mobile.onboarding.secretKeyHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du findest ihn in deinem Emergency Kit oder in den Einstellungen auf deinem Computer. Groß- und Kleinschreibung und Bindestriche spielen keine Rolle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You find it in your Emergency Kit or in Settings on your computer. Capital letters and dashes do not matter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La encuentras en tu Kit de emergencia o en Ajustes en tu equipo. Las mayúsculas y los guiones no importan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous la trouvez dans votre kit d’urgence ou dans les réglages sur votre ordinateur. Les majuscules et les tirets n’ont pas d’importance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La trovi nel tuo Kit di emergenza o nelle Impostazioni sul computer. Maiuscole e trattini non contano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊急キット、またはパソコンの設定にあります。大文字・小文字やダッシュは区別されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비상 키트나 컴퓨터의 설정에서 찾을 수 있어요. 대문자와 대시는 상관없어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je vindt hem in je Noodkit of in de instellingen op je computer. Hoofdletters en streepjes maken niet uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znajdziesz go w Zestawie awaryjnym lub w Ustawieniach na komputerze. Wielkie litery i myślniki nie mają znaczenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você a encontra no seu Kit de Emergência ou em Configurações no seu computador. Letras maiúsculas e traços não importam."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onu Acil Durum Kitinizde veya bilgisayarınızdaki Ayarlar’da bulursunuz. Büyük harfler ve tireler önemli değil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在紧急工具包中或电脑上的“设置”里找到它。大小写和短横线都无关紧要。"
          }
        }
      }
    },
