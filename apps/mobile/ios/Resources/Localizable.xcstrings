    "mobile.ext.confirmFillBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS teilt Mosaic nicht mit, auf welcher Seite du bist, deshalb kann Mosaic das nicht prüfen. Fülle nur aus, wenn das die Website ist, die du meinst. Danach fragt Mosaic nach Face ID oder Touch ID."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS does not tell Mosaic which page you are on, so Mosaic cannot check it. Fill only if this is the site you mean. Mosaic then asks for Face ID or Touch ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS no le dice a Mosaic en qué página estás, así que Mosaic no puede comprobarlo. Rellena solo si es el sitio que quieres. Después, Mosaic pide Face ID o Touch ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ne dit pas à Mosaic sur quelle page vous êtes, Mosaic ne peut donc pas la vérifier. Ne remplissez que si c’est bien le site que vous voulez. Mosaic demande ensuite Face ID ou Touch ID."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS non dice a Mosaic su quale pagina ti trovi, quindi Mosaic non può verificarlo. Compila solo se questo è il sito che intendi. Poi Mosaic chiede Face ID o Touch ID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS は、どのページを開いているかを Mosaic に伝えないため、Mosaic は確認できません。意図したサイトである場合にのみ入力してください。その後、Mosaic は Face ID または Touch ID を求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS는 어느 페이지에 있는지 Mosaic에 알려 주지 않아서 Mosaic이 확인할 수 없어요. 의도한 사이트일 때만 입력하세요. 그러면 Mosaic이 Face ID 또는 Touch ID를 요청해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS vertelt Mosaic niet op welke pagina je zit, dus Mosaic kan dat niet controleren. Vul alleen in als dit de site is die je bedoelt. Mosaic vraagt daarna om Face ID of Touch ID."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS nie informuje Mosaic, na której stronie jesteś, więc Mosaic nie może tego sprawdzić. Wypełniaj tylko wtedy, gdy to witryna, o którą chodzi. Mosaic poprosi wtedy o Face ID lub Touch ID."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS não informa ao Mosaic em qual página você está, então o Mosaic não consegue verificar. Só preencha se este for o site que você quer. Depois o Mosaic pede o Face ID ou o Touch ID."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS, Mosaic’e hangi sayfada olduğunuzu söylemez, bu yüzden Mosaic bunu kontrol edemez. Yalnızca kastettiğiniz site buysa doldurun. Mosaic sonra Face ID veya Touch ID ister."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 不会告诉 Mosaic 你正在访问哪个页面，所以 Mosaic 无法核对。只有在这确实是你要访问的网站时才填充。随后 Mosaic 会要求使用面容 ID 或触控 ID。"
          }
        }
      }
    },
