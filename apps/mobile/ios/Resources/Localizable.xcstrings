    "mobile.deviceLock.required.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic schützt deine Schlüssel mit der Bildschirmsperre deines Handys. Lege in den Systemeinstellungen eine PIN, ein Muster oder ein Passwort fest und komm dann zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic keeps your keys behind your phone's screen lock. Set a PIN, pattern or password in the system settings, then come back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic guarda tus claves tras el bloqueo de pantalla de tu teléfono. Configura un PIN, un patrón o una contraseña en los ajustes del sistema y vuelve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic garde vos clés derrière le verrouillage d’écran de votre téléphone. Définissez un code PIN, un schéma ou un mot de passe dans les réglages du système, puis revenez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic tiene le tue chiavi dietro il blocco schermo del telefono. Imposta un PIN, una sequenza o una password nelle impostazioni di sistema, poi torna qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic は、スマートフォンの画面ロックの内側にキーを保管します。システム設定で PIN、パターン、またはパスワードを設定してから、戻ってきてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic은 휴대폰의 화면 잠금 뒤에 키를 보관해요. 시스템 설정에서 PIN, 패턴 또는 비밀번호를 설정한 다음 돌아오세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic bewaart je sleutels achter de schermvergrendeling van je telefoon. Stel in de systeeminstellingen een pincode, patroon of wachtwoord in en kom dan terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic przechowuje Twoje klucze za blokadą ekranu telefonu. Ustaw PIN, wzór lub hasło w ustawieniach systemu, a potem wróć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mosaic guarda as suas chaves atrás do bloqueio de tela do celular. Defina um PIN, padrão ou senha nas configurações do sistema e volte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic anahtarlarınızı telefonunuzun ekran kilidinin arkasında tutar. Sistem ayarlarında bir PIN, desen veya parola belirleyin, sonra geri dönün."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic 把你的密钥保护在手机的屏幕锁定之后。请在系统设置中设置 PIN、图案或密码，然后回来。"
          }
        }
      }
    },
