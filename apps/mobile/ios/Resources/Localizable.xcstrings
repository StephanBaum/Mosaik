    "mobile.unlock.quickInvalidated" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Face-ID-Einstellungen haben sich geändert. Entsperre mit deinem Master-Passwort, um die Schnellentsperrung wieder einzuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
