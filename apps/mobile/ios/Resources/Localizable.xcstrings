    "mobile.about.preAudit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic ist Pre-Audit-Software. Ein unabhängiges Sicherheitsaudit hat noch nicht stattgefunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
