    "mobile.ext.configBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic bietet deine Logins, Passkeys und Einmalcodes an, wenn du ein Feld oder eine Anmelde-Schaltfläche antippst. Was Mosaic anbietet, änderst du in den Einstellungen der Mosaic-App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic offers your logins, passkeys and one-time codes when you tap a field or a sign-in button. You change what it offers in Settings in the Mosaic app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic ofrece tus inicios de sesión, llaves de acceso y códigos de un solo uso cuando tocas un campo o un botón de inicio de sesión. Cambias lo que ofrece en Ajustes, en la app de Mosaic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic propose vos identifiants, clés d’accès et codes à usage unique quand vous touchez un champ ou un bouton de connexion. Vous modifiez ce qu’il propose dans les réglages de l’application Mosaic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic propone i tuoi accessi, le passkey e i codici monouso quando tocchi un campo o un pulsante di accesso. Cambi ciò che propone in Impostazioni nell'app Mosaic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力欄やサインインボタンをタップすると、Mosaic がログイン、パスキー、ワンタイムコードを提案します。提案する内容は、Mosaic アプリの「設定」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력란이나 로그인 버튼을 탭하면 Mosaic이 로그인, 패스키, 일회용 코드를 제안해요. 제안하는 항목은 Mosaic 앱의 설정에서 변경할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic biedt je logins, passkeys en eenmalige codes aan wanneer je op een veld of een inlogknop tikt. Wat het aanbiedt wijzig je bij Instellingen in de Mosaic-app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic proponuje Twoje logowania, klucze dostępu i kody jednorazowe, gdy dotkniesz pola lub przycisku logowania. To, co proponuje, zmieniasz w Ustawieniach w aplikacji Mosaic."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mosaic oferece os seus logins, chaves de acesso e códigos de uso único quando você toca em um campo ou em um botão de login. Você muda o que ele oferece em Configurações, no app Mosaic."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic, bir alana veya oturum açma düğmesine dokunduğunuzda girişlerinizi, geçiş anahtarlarınızı ve tek kullanımlık kodlarınızı sunar. Neyi sunacağını Mosaic uygulamasındaki Ayarlar’da değiştirirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你点按输入框或登录按钮时，Mosaic 会提供你的登录信息、通行密钥和一次性验证码。你可以在 Mosaic 应用的“设置”中更改它提供的内容。"
          }
        }
      }
    },
    "mobile.ext.configTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
