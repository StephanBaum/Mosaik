    "mobile.onboarding.second.keyWaiting" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte auf deinen Sicherheitsschlüssel. Schließe den Vorgang im Browser ab und komm dann zurück. Der Code dort sollte %1$@ lauten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for your security key. Finish in the browser, then come back. The code there should read %1$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando tu llave de seguridad. Termina en el navegador y vuelve aquí. El código que aparece allí debería ser %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente de votre clé de sécurité. Terminez dans le navigateur, puis revenez ici. Le code affiché là-bas doit être %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In attesa della tua chiave di sicurezza. Completa l'operazione nel browser, poi torna qui. Il codice mostrato lì dovrebbe essere %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セキュリティキーを待っています。ブラウザで完了してから、戻ってきてください。そこに表示されるコードは %1$@ のはずです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보안 키를 기다리는 중이에요. 브라우저에서 마친 다음 돌아오세요. 그곳의 코드는 %1$@(이)어야 해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wachten op je beveiligingssleutel. Rond het af in de browser en kom dan terug. De code daar moet %1$@ zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czekanie na klucz bezpieczeństwa. Dokończ w przeglądarce, a potem wróć. Kod tam powinien brzmieć %1$@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando a sua chave de segurança. Conclua no navegador e volte. O código lá deve ser %1$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenlik anahtarınız bekleniyor. Tarayıcıda bitirin, sonra buraya dönün. Oradaki kod %1$@ olmalı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待你的安全密钥。请在浏览器中完成，然后回到这里。那里显示的验证码应为 %1$@。"
          }
        }
      }
