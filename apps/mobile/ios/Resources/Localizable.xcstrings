    "mobile.folder.scope" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ fragt nach Zugriff auf alle deine Dateien. Mosaic öffnet nur den Ordner, den du auswählst, und rührt sonst nichts an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ will ask for access to all your files. Mosaic only opens the folder you choose and never touches anything else."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ pedirá acceso a todos tus archivos. Mosaic solo abre la carpeta que elijas y nunca toca nada más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ demandera l’accès à tous vos fichiers. Mosaic n’ouvre que le dossier que vous choisissez et ne touche à rien d’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ chiederà l'accesso a tutti i tuoi file. Mosaic apre solo la cartella che scegli e non tocca mai nient'altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は、すべてのファイルへのアクセスを求めます。Mosaic は選択したフォルダのみを開き、それ以外には一切触れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) 모든 파일에 대한 접근을 요청해요. Mosaic은 선택한 폴더만 열고 다른 것은 건드리지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vraagt toegang tot al je bestanden. Mosaic opent alleen de map die je kiest en raakt niets anders aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ poprosi o dostęp do wszystkich Twoich plików. Mosaic otwiera tylko wybrany folder i niczego innego nie dotyka."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %1$@ pedirá acesso a todos os seus arquivos. O Mosaic só abre a pasta que você escolher e nunca toca em mais nada."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tüm dosyalarınıza erişim isteyecek. Mosaic yalnızca seçtiğiniz klasörü açar ve başka hiçbir şeye dokunmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 会请求访问你所有的文件。Mosaic 只会打开你选择的文件夹，绝不会碰其他任何内容。"
          }
        }
      }
    },
    "mobile.folder.serverConfirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic meldet sich bei %1$@ an. Mach nur weiter, wenn das dein eigener Server ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic will sign in at %1$@. Only continue if this is your own server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic iniciará sesión en %1$@. Continúa solo si es tu propio servidor."
          }
        },
        "fr" : {
