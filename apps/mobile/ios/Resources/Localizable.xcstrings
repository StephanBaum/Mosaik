        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completa l'accesso nel browser. Controlla che mostri il codice %1$@, poi torna qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウザでサインインを完了してください。コード %1$@ が表示されていることを確認してから、ここに戻ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라우저에서 로그인을 마치세요. %1$@ 코드가 표시되는지 확인한 다음 여기로 돌아오세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rond het inloggen af in je browser. Controleer of de code %1$@ wordt getoond en kom dan hier terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokończ logowanie w przeglądarce. Sprawdź, czy pokazuje kod %1$@, a potem wróć tutaj."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conclua o login no navegador. Confira se ele mostra o código %1$@ e volte aqui."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum açmayı tarayıcınızda bitirin. %1$@ kodunu gösterdiğini kontrol edin, sonra buraya dönün."
