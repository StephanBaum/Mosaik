    "error.syncPasswordChanged" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Master-Passwort wurde auf dem Server oder im Ordner geändert. Gib unten das neue ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your master password was changed on the server or in the folder. Enter the new one below."
          }
        }
      }
    },
    "error.syncRateLimited" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Versuche. Warte ein paar Minuten und versuche es dann noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many attempts. Wait a few minutes, then try again."
          }
        }
      }
    },
    "error.syncServerIncompatible" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server läuft in einer Version, die nicht zu deinem Mosaic passt. Aktualisiere Mosaic oder bitte den Betreiber des Servers, ihn zu aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server runs a version that doesn't match your Mosaic. Update Mosaic or ask the server's owner to update it."
          }
        }
      }
    },
    "error.syncServerInsecure" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic verbindet sich nur per https mit Servern, damit unterwegs niemand deine Daten lesen oder ändern kann. Nimm eine Adresse mit https://."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic only connects to servers over https, so nobody on the way can read or change your data. Use an https:// address."
          }
        }
      }
    },
    "error.syncServerInvalid" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sieht nicht nach einem Mosaic-Server aus. Prüfe die Adresse; sie sollte so aussehen: https://sync.example.com."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This doesn't look like a Mosaic server. Check the address; it should look like https://sync.example.com."
          }
        }
      }
    },
    "error.syncServerMismatch" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist nicht der Server, mit dem dieses Konto synchronisiert. Prüfe die Adresse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This isn't the server this account syncs with. Check the address."
          }
        }
      }
    },
    "error.syncServerUnreachable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic konnte den Server nicht erreichen. Prüfe die Adresse und deine Internetverbindung und versuche es dann noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic couldn't reach the server. Check the address and your internet connection, then try again."
          }
        }
      }
    },
    "error.syncSignedOut" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat dieses Gerät abgemeldet. Melde dich erneut an, um weiter zu synchronisieren. Deine Änderungen sind auf diesem Gerät sicher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server signed this device out. Sign in again to keep syncing. Your changes are safe on this device."
          }
        }
      }
    },
    "error.syncTwoFactorInvalid" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Code stimmt nicht oder ist abgelaufen. Gib den aktuellen 6-stelligen Code aus deiner Authenticator-App ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That code isn't right or has expired. Enter the current 6-digit code from your authenticator app."
          }
        }
      }
    },
    "error.syncTwoFactorRequired" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
