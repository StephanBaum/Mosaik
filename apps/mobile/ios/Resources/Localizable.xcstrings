          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic only connects to servers over https, so nobody on the way can read or change your data. Use an https:// address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic solo se conecta a servidores mediante https, para que nadie por el camino pueda leer ni cambiar tus datos. Usa una dirección https://."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic ne se connecte aux serveurs qu’en https, pour que personne en chemin ne puisse lire ou modifier vos données. Utilisez une adresse https://."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic si collega ai server solo tramite https, così nessuno lungo il percorso può leggere o modificare i tuoi dati. Usa un indirizzo https://."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic は、途中で誰にもデータを読み取られたり変更されたりしないよう、https のサーバーにのみ接続します。https:// のアドレスを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic은 중간에서 아무도 데이터를 읽거나 바꿀 수 없도록 https로만 서버에 연결해요. https:// 주소를 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic maakt alleen via https verbinding met servers, zodat niemand onderweg je gegevens kan lezen of wijzigen. Gebruik een https://-adres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic łączy się z serwerami tylko przez https, aby nikt po drodze nie mógł odczytać ani zmienić Twoich danych. Użyj adresu https://."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mosaic só se conecta a servidores por https, para que ninguém no caminho possa ler ou alterar os seus dados. Use um endereço https://."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic sunuculara yalnızca https üzerinden bağlanır; böylece yoldaki kimse verilerinizi okuyamaz veya değiştiremez. https:// ile başlayan bir adres kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic 只通过 https 连接服务器，这样途中无人能读取或更改你的数据。请使用 https:// 地址。"
          }
        }
      }
    },
