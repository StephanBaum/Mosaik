    "mobile.reset.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das löscht die Tresor-Kopie, den Secret Key und die Cloud-Anmeldung auf diesem Handy. Deine Daten im Cloud-Ordner oder auf dem Server bleiben erhalten. Du kannst später mit deinem Secret Key und Master-Passwort wieder beitreten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes the vault copy, the Secret Key and the cloud sign-in stored on this phone. Your data in the cloud folder or on the server stays. You can join again later with your Secret Key and master password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina la copia de la caja fuerte, la Clave secreta y el inicio de sesión en la nube guardados en este teléfono. Tus datos en la carpeta de la nube o en el servidor se conservan. Puedes volver a unirte más tarde con tu Clave secreta y tu contraseña maestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime la copie du coffre-fort, la clé secrète et la connexion au cloud stockées sur ce téléphone. Vos données dans le dossier cloud ou sur le serveur restent en place. Vous pourrez rejoindre le compte plus tard avec votre clé secrète et votre mot de passe principal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo elimina la copia della cassaforte, la Chiave segreta e l'accesso al cloud memorizzati su questo telefono. I tuoi dati nella cartella cloud o sul server restano. Potrai unirti di nuovo in seguito con la tua Chiave segreta e la password principale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスマートフォンに保存されている保管庫のコピー、シークレットキー、クラウドへのサインイン情報を削除します。クラウドフォルダやサーバーにあるデータは残ります。後からシークレットキーとマスターパスワードで、もう一度参加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 휴대폰에 저장된 보관함 사본, 비밀 키, 클라우드 로그인이 삭제돼요. 클라우드 폴더나 서버에 있는 데이터는 그대로 남아요. 나중에 비밀 키와 마스터 비밀번호로 다시 참여할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit verwijdert de kluiskopie, de Geheime Sleutel en de cloudaanmelding die op deze telefoon staan. Je gegevens in de cloudmap of op de server blijven bestaan. Je kunt later weer aansluiten met je Geheime Sleutel en hoofdwachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To usuwa kopię sejfu, Klucz tajny i logowanie do chmury zapisane na tym telefonie. Twoje dane w folderze w chmurze lub na serwerze pozostają. Możesz później dołączyć ponownie z Kluczem tajnym i hasłem głównym."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto exclui a cópia do cofre, a Chave Secreta e o login na nuvem guardados neste celular. Seus dados na pasta da nuvem ou no servidor continuam. Você poderá entrar de novo depois com a sua Chave Secreta e a senha mestra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, bu telefonda saklanan kasa kopyasını, Gizli Anahtarı ve bulut oturumunu siler. Bulut klasöründeki veya sunucudaki verileriniz kalır. Daha sonra Gizli Anahtarınız ve ana parolanızla yeniden katılabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会删除这部手机上存储的保险库副本、机密密钥和云端登录信息。你在云端文件夹或服务器上的数据会保留。你之后可以用机密密钥和主密码重新加入。"
          }
        }
      }
    },
