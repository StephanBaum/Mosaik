          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic denetim öncesi bir yazılımdır. Henüz bağımsız bir güvenlik denetimi yapılmadı."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
