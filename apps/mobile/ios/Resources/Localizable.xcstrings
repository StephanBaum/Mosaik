    "mobile.onboarding.quick.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperre Mosaic beim nächsten Mal mit deinem Fingerabdruck. Nach einem Neustart des Handys brauchst du einmal dein Master-Passwort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use your fingerprint to unlock Mosaic next time. After a restart of the phone you still need your master password once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa tu huella para desbloquear Mosaic la próxima vez. Tras reiniciar el teléfono sigues necesitando tu contraseña maestra una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez votre empreinte pour déverrouiller Mosaic la prochaine fois. Après un redémarrage du téléphone, votre mot de passe principal reste nécessaire une fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la tua impronta digitale per sbloccare Mosaic la prossima volta. Dopo un riavvio del telefono ti serve comunque la password principale una volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次回から、指紋で Mosaic のロックを解除できます。スマートフォンの再起動後は、1回だけマスターパスワードが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음부터는 지문으로 Mosaic 잠금을 해제하세요. 휴대폰을 다시 시작한 후에는 마스터 비밀번호가 한 번 필요해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik je vingerafdruk om Mosaic de volgende keer te ontgrendelen. Na een herstart van de telefoon heb je je hoofdwachtwoord nog één keer nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj odcisku palca, aby następnym razem odblokować Mosaic. Po ponownym uruchomieniu telefonu nadal raz potrzebne jest hasło główne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a sua impressão digital para desbloquear o Mosaic da próxima vez. Após reiniciar o celular, você ainda precisa da sua senha mestra uma vez."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sonraki sefer Mosaic’in kilidini açmak için parmak izinizi kullanın. Telefon yeniden başlatıldıktan sonra ana parolanız yine bir kez gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次用指纹解锁 Mosaic。手机重启后，你仍需输入一次主密码。"
          }
        }
      }
    },
