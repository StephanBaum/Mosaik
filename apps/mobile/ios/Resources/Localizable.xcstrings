{
  "sourceLanguage" : "en",
  "strings" : {
    "error.accountExists" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät gibt es schon ein Mosaic-Konto. Entsperre es stattdessen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device already has a Mosaic account. Unlock it instead."
          }
        }
      }
    },
    "error.appNotLinked" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App ist mit keiner gespeicherten Website verknüpft. Verknüpfe sie zuerst in Mosaic und versuche es dann noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app isn't linked to a saved website. Link it in Mosaic first, then try again."
          }
        }
      }
    },
    "error.appNotVerified" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App ist für die Website nicht bestätigt, deshalb nutzt Mosaic ihre Passkeys nicht. Öffne die Website stattdessen im Browser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app isn't verified for that website, so Mosaic won't use its passkeys. Use the website in a browser instead."
          }
        }
      }
    },
    "error.assetLinksUnavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic konnte nicht prüfen, ob diese App zur Website gehört. Prüfe deine Verbindung und versuche es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic couldn't check that this app belongs to the website. Check your connection and try again."
          }
        }
      }
    },
    "error.busy" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic schließt noch den letzten Schritt ab. Warte kurz und versuche es dann noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic is still finishing the last step. Wait a moment, then try again."
          }
        }
      }
    },
    "error.emptyPassword" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Master-Passwort ist leer. Gib es ein, um weiterzumachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The master password is empty. Enter it to continue."
          }
        }
      }
    },
    "error.folderAccountUnsupported" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Konto synchronisiert über einen Cloud-Ordner, den Mosaic auf Smartphones noch nicht unterstützt. Nutze einen Desktop oder ein Konto auf einem Sync-Server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This account syncs through a cloud folder, which Mosaic on phones doesn't support yet. Use a desktop or a sync server account."
          }
        }
      }
    },
    "error.foreignFrame" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Feld gehört zu einer anderen, in die Seite eingebetteten Website. Mosaic füllt es deshalb nicht aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This field belongs to another site embedded in the page, so Mosaic won't fill it."
          }
        }
      }
    },
    "error.insecureOrigin" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Seite nutzt keine sichere Verbindung, deshalb füllt Mosaic sie nicht aus. Öffne die https-Version der Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This page isn't using a secure connection, so Mosaic won't fill it. Open the https version of the page."
          }
        }
      }
    },
    "error.internal" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas Unerwartetes hat diese Aktion gestoppt. Versuche es noch einmal und starte Mosaic neu, wenn es wieder passiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something unexpected stopped this action. Try again, and restart Mosaic if it keeps happening."
          }
        }
      }
    },
    "error.invalidInput" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas in diesem Formular ist ungültig. Prüfe die markierten Felder und versuche es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something in this form isn't valid. Check the highlighted fields and try again."
          }
        }
      }
    },
    "error.itemTypeNotAllowed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Tresor enthält nur Einmalcodes."
          }
        },
