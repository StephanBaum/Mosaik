        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic es software previo a una auditoría. Aún no se ha realizado ninguna auditoría de seguridad independiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
