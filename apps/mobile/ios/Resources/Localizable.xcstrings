    "error.folderNotFound" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic findet diesen Ordner nicht, oder es ist kein Mosaic-Ordner. Wähle den Ordner, mit dem dein Computer synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic can't find that folder, or it isn't a Mosaic folder. Pick the folder your computer syncs to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic no encuentra esa carpeta o no es una carpeta de Mosaic. Elige la carpeta con la que se sincroniza tu equipo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic ne trouve pas ce dossier, ou ce n’est pas un dossier Mosaic. Choisissez le dossier avec lequel votre ordinateur se synchronise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic non trova quella cartella, oppure non è una cartella Mosaic. Scegli la cartella con cui si sincronizza il tuo computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic はそのフォルダを見つけられないか、Mosaic のフォルダではありません。パソコンが同期しているフォルダを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
