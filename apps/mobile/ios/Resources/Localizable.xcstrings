          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic rellena solo los inicios de sesión guardados para este sitio. Abre Mosaic para añadir este sitio a un inicio de sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
