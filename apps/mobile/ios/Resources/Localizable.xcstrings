    "mobile.settings.passwordIdentitiesHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic teilt dem System Website und Benutzernamen jedes Logins mit. Das System speichert diese Liste auf dem Handy, außerhalb der Verschlüsselung von Mosaic."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic tells the system the website and username of each login. The system keeps this list on the phone, outside Mosaic's encryption."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic informa al sistema del sitio web y del nombre de usuario de cada inicio de sesión. El sistema guarda esta lista en el teléfono, fuera del cifrado de Mosaic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic indique au système le site web et le nom d’utilisateur de chaque identifiant. Le système conserve cette liste sur le téléphone, en dehors du chiffrement de Mosaic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic comunica al sistema il sito web e il nome utente di ogni accesso. Il sistema conserva questo elenco sul telefono, fuori dalla cifratura di Mosaic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic は、各ログインのウェブサイトとユーザー名をシステムに伝えます。システムはこの一覧を、Mosaic の暗号化の外にある、スマートフォン上に保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic이 각 로그인의 웹사이트와 사용자 이름을 시스템에 알려 줘요. 시스템은 이 목록을 Mosaic의 암호화 밖에서 휴대폰에 보관해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic vertelt het systeem de website en gebruikersnaam van elke login. Het systeem bewaart deze lijst op de telefoon, buiten de versleuteling van Mosaic."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic przekazuje systemowi witrynę i nazwę użytkownika każdego logowania. System przechowuje tę listę na telefonie, poza szyfrowaniem Mosaic."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mosaic informa ao sistema o site e o nome de usuário de cada login. O sistema guarda essa lista no celular, fora da criptografia do Mosaic."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic, sisteme her girişin web sitesini ve kullanıcı adını bildirir. Sistem bu listeyi telefonda, Mosaic’in şifrelemesinin dışında tutar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic 会把每条登录信息的网站和用户名告知系统。系统把这份列表保存在手机上，不受 Mosaic 的加密保护。"
          }
        }
      }
    },
    "mobile.settings.passwordIdentitiesLimit" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen Vorschlag antippst, teilt iOS Mosaic nicht mit, auf welcher Seite du bist. Deshalb zeigt Mosaic die gespeicherte Website und füllt erst aus, nachdem du sie bestätigt und mit Face ID oder Touch ID entsperrt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you tap a suggestion, iOS does not tell Mosaic which page you are on. So Mosaic shows the saved site and fills only after you confirm it and unlock with Face ID or Touch ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando tocas una sugerencia, iOS no le dice a Mosaic en qué página estás. Por eso Mosaic muestra el sitio guardado y rellena solo después de que lo confirmes y desbloquees con Face ID o Touch ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous touchez une suggestion, iOS ne dit pas à Mosaic sur quelle page vous êtes. Mosaic affiche donc le site enregistré et ne remplit qu’après votre confirmation et un déverrouillage avec Face ID ou Touch ID."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando tocchi un suggerimento, iOS non dice a Mosaic su quale pagina ti trovi. Per questo Mosaic mostra il sito salvato e compila solo dopo che lo confermi e sblocchi con Face ID o Touch ID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提案をタップしたとき、iOS は、どのページを開いているかを Mosaic に伝えません。そのため、Mosaic は保存済みのサイトを表示し、確認して Face ID または Touch ID でロックを解除した後にのみ入力します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제안을 탭할 때 iOS는 어느 페이지에 있는지 Mosaic에 알려 주지 않아요. 그래서 Mosaic은 저장된 사이트를 표시하고, 확인한 후 Face ID 또는 Touch ID로 잠금을 해제해야만 입력해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer je op een suggestie tikt, vertelt iOS Mosaic niet op welke pagina je zit. Daarom toont Mosaic de bewaarde site en vult het pas in nadat je dat bevestigt en ontgrendelt met Face ID of Touch ID."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy dotkniesz propozycji, iOS nie informuje Mosaic, na której stronie jesteś. Dlatego Mosaic pokazuje zapisaną witrynę i wypełnia dopiero po Twoim potwierdzeniu i odblokowaniu za pomocą Face ID lub Touch ID."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando você toca em uma sugestão, o iOS não informa ao Mosaic em qual página você está. Por isso o Mosaic mostra o site salvo e só preenche depois que você confirma e desbloqueia com o Face ID ou o Touch ID."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir öneriye dokunduğunuzda iOS, Mosaic’e hangi sayfada olduğunuzu söylemez. Bu yüzden Mosaic kayıtlı siteyi gösterir ve yalnızca siz onaylayıp Face ID veya Touch ID ile kilidi açtıktan sonra doldurur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你点按某条建议时，iOS 不会告诉 Mosaic 你正在访问哪个页面。因此 Mosaic 会显示已保存的网站，并且只有在你确认并用面容 ID 或触控 ID 解锁后才填充。"
          }
        }
      }
    },
