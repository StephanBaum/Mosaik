    "mobile.settings.credentialHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android kann deine Passkeys und Passwörter aus Mosaic auch anbieten, wenn eine App nach einer Anmeldung fragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android can also offer your passkeys and passwords from Mosaic when an app asks you to sign in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android también puede ofrecer tus llaves de acceso y contraseñas de Mosaic cuando una app te pide iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
