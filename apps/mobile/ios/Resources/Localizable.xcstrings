        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic è un software in fase pre-audit. Non è ancora stato fatto nessun audit di sicurezza indipendente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic は監査前のソフトウェアです。独立したセキュリティ監査は、まだ行われていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic은 감사 전 소프트웨어예요. 독립적인 보안 감사를 아직 받지 않았어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
