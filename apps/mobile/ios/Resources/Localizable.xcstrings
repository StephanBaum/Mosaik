    "mobile.folder.msRevokeHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Mosaics Zugriff ganz zu entfernen, entferne die App auf der Seite deines Microsoft-Kontos unter Apps."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To remove Mosaic's access completely, remove it on your Microsoft account page under Apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para quitar por completo el acceso de Mosaic, quítalo en la página de tu cuenta de Microsoft, en Aplicaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour supprimer complètement l’accès de Mosaic, retirez-le sur la page de votre compte Microsoft, sous Applications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per rimuovere del tutto l'accesso di Mosaic, rimuovilo nella pagina del tuo account Microsoft, sotto App."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic のアクセスを完全に削除するには、Microsoft アカウントのページの「アプリ」から削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic의 접근 권한을 완전히 없애려면 Microsoft 계정 페이지의 앱에서 제거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om de toegang van Mosaic helemaal te verwijderen, verwijder je Mosaic op de pagina van je Microsoft-account onder Apps."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby całkowicie usunąć dostęp Mosaic, usuń go na stronie konta Microsoft w sekcji Aplikacje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para remover por completo o acesso do Mosaic, remova-o na página da sua conta Microsoft, em Aplicativos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic’in erişimini tamamen kaldırmak için Microsoft hesap sayfanızda Uygulamalar altından kaldırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要彻底移除 Mosaic 的访问权限，请在你的 Microsoft 账户页面的“应用”下移除它。"
          }
        }
      }
    },
    "mobile.folder.noDrive" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Drive und iCloud Drive funktionieren unter Android noch nicht. Nimm Dropbox, OneDrive, Nextcloud oder die Mosaic-Synchronisierung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Drive and iCloud Drive don't work on Android yet. Use Dropbox, OneDrive, Nextcloud or Mosaic sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Drive e iCloud Drive aún no funcionan en Android. Usa Dropbox, OneDrive, Nextcloud o la sincronización de Mosaic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Drive et iCloud Drive ne fonctionnent pas encore sur Android. Utilisez Dropbox, OneDrive, Nextcloud ou la synchronisation Mosaic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Drive e iCloud Drive non funzionano ancora su Android. Usa Dropbox, OneDrive, Nextcloud o la sincronizzazione di Mosaic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google ドライブと iCloud Drive は、まだ Android では使えません。Dropbox、OneDrive、Nextcloud、または Mosaic の同期を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Drive와 iCloud Drive는 아직 Android에서 사용할 수 없어요. Dropbox, OneDrive, Nextcloud 또는 Mosaic 동기화를 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Drive en iCloud Drive werken nog niet op Android. Gebruik Dropbox, OneDrive, Nextcloud of Mosaic-synchronisatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Drive i iCloud Drive nie działają jeszcze na Androidzie. Użyj Dropbox, OneDrive, Nextcloud lub synchronizacji Mosaic."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Drive e iCloud Drive ainda não funcionam no Android. Use Dropbox, OneDrive, Nextcloud ou a sincronização do Mosaic."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Drive ve iCloud Drive henüz Android’de çalışmıyor. Dropbox, OneDrive, Nextcloud veya Mosaic eşitlemesini kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
