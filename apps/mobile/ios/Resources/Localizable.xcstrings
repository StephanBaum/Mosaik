{
  "sourceLanguage" : "en",
  "strings" : {
    "error.accountExists" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät gibt es schon ein Mosaic-Konto. Entsperre es stattdessen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device already has a Mosaic account. Unlock it instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo ya tiene una cuenta de Mosaic. Desbloquéala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil a déjà un compte Mosaic. Déverrouillez-le plutôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo ha già un account Mosaic. Sbloccalo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスには、すでに Mosaic のアカウントがあります。ロックを解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에는 이미 Mosaic 계정이 있어요. 대신 잠금을 해제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat heeft al een Mosaic-account. Ontgrendel dat in plaats daarvan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie ma już konto Mosaic. Odblokuj je zamiast tworzyć nowe."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo já tem uma conta do Mosaic. Desbloqueie-a."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıtta zaten bir Mosaic hesabı var. Bunun yerine kilidini açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台设备上已有 Mosaic 账户。请直接解锁。"
          }
        }
      }
    },
    "error.appNotLinked" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App ist mit keiner gespeicherten Website verknüpft. Verknüpfe sie zuerst in Mosaic und versuche es dann noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app isn't linked to a saved website. Link it in Mosaic first, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app no está vinculada a un sitio web guardado. Vincúlala primero en Mosaic y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette application n’est pas associée à un site web enregistré. Associez-la d’abord dans Mosaic, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa app non è collegata a un sito web salvato. Collegala prima in Mosaic, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリは、保存されたウェブサイトにリンクされていません。先に Mosaic でリンクしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱은 저장된 웹사이트에 연결되어 있지 않아요. 먼저 Mosaic에서 연결한 다음 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze app is niet gekoppeld aan een bewaarde website. Koppel hem eerst in Mosaic en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta aplikacja nie jest powiązana z zapisaną witryną. Najpierw powiąż ją w Mosaic, a potem spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este app não está vinculado a um site salvo. Vincule-o antes no Mosaic e tente de novo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulama kayıtlı bir web sitesine bağlı değil. Önce Mosaic’te bağlayın, sonra yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此应用尚未关联到已保存的网站。请先在 Mosaic 中关联，然后重试。"
          }
        }
      }
    },
    "error.appNotVerified" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App ist für die Website nicht bestätigt, deshalb nutzt Mosaic ihre Passkeys nicht. Öffne die Website stattdessen im Browser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app isn't verified for that website, so Mosaic won't use its passkeys. Use the website in a browser instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app no está verificada para ese sitio web, así que Mosaic no usará sus llaves de acceso. Usa el sitio web en un navegador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette application n’est pas vérifiée pour ce site web, Mosaic n’utilisera donc pas ses clés d’accès. Utilisez plutôt le site web dans un navigateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa app non è verificata per quel sito web, quindi Mosaic non usa le sue passkey. Usa invece il sito web in un browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリはそのウェブサイトについて確認されていないため、Mosaic はそのパスキーを使用しません。代わりに、ブラウザでウェブサイトを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱은 해당 웹사이트에 대해 확인되지 않아서 Mosaic이 패스키를 사용하지 않아요. 대신 브라우저에서 웹사이트를 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze app is niet geverifieerd voor die website, dus Mosaic gebruikt zijn passkeys niet. Gebruik in plaats daarvan de website in een browser."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta aplikacja nie jest zweryfikowana dla tej witryny, więc Mosaic nie użyje jej kluczy dostępu. Użyj zamiast tego witryny w przeglądarce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este app não está verificado para esse site, então o Mosaic não usará as chaves de acesso dele. Use o site em um navegador."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulama o web sitesi için doğrulanmadı, bu yüzden Mosaic onun geçiş anahtarlarını kullanmaz. Bunun yerine web sitesini bir tarayıcıda kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此应用未通过该网站的验证，所以 Mosaic 不会使用它的通行密钥。请改为在浏览器中使用该网站。"
          }
        }
      }
    },
    "error.assetLinksUnavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic konnte nicht prüfen, ob diese App zur Website gehört. Prüfe deine Verbindung und versuche es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic couldn't check that this app belongs to the website. Check your connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic no pudo comprobar que esta app pertenece al sitio web. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic n’a pas pu vérifier que cette application appartient au site web. Vérifiez votre connexion et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic non è riuscito a verificare che questa app appartenga al sito web. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリがウェブサイトに属していることを、Mosaic は確認できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱이 해당 웹사이트에 속하는지 Mosaic이 확인할 수 없었어요. 연결을 확인한 다음 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic kon niet controleren of deze app bij de website hoort. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic nie mógł sprawdzić, czy ta aplikacja należy do witryny. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mosaic não conseguiu verificar se este app pertence ao site. Verifique a sua conexão e tente de novo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic bu uygulamanın web sitesine ait olduğunu doğrulayamadı. Bağlantınızı kontrol edin ve yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic 无法核实此应用是否属于该网站。请检查网络连接后重试。"
          }
        }
      }
    },
    "error.busy" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic schließt noch den letzten Schritt ab. Warte kurz und versuche es dann noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic is still finishing the last step. Wait a moment, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic aún está terminando el último paso. Espera un momento y vuelve a intentarlo."
