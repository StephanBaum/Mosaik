    "mobile.onboarding.password.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic sendet es nirgendwohin. Es entsperrt deinen Tresor auf diesem Handy."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic never sends it anywhere. It unlocks your vault on this phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic nunca la envía a ninguna parte. Desbloquea tu caja fuerte en este teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic ne l’envoie jamais nulle part. Il déverrouille votre coffre-fort sur ce téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic non la invia mai da nessuna parte. Sblocca la tua cassaforte su questo telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic がどこかへ送信することはありません。このスマートフォンで保管庫のロックを解除するためのものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic은 이 비밀번호를 어디로도 보내지 않아요. 이 휴대폰에서 보관함을 여는 데 사용돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic verstuurt het nergens naartoe. Het ontgrendelt je kluis op deze telefoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic nigdy nigdzie go nie wysyła. Odblokowuje on Twój sejf na tym telefonie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mosaic nunca a envia a lugar nenhum. Ela desbloqueia o seu cofre neste celular."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic onu hiçbir yere göndermez. Kasanızın kilidini bu telefonda açar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic 绝不会把它发送到任何地方。它用来在这部手机上解锁你的保险库。"
          }
        }
      }
    },
