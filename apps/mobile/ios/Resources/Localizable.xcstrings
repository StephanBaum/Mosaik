    "mobile.settings.passkeyIdentitiesHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic teilt dem System Website und Benutzernamen jedes Passkeys mit, damit es ihn anbieten kann. Die Schlüssel verlassen Mosaic nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic tells the system the website and username of each passkey so it can offer it. The keys never leave Mosaic."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic informa al sistema del sitio web y del nombre de usuario de cada llave de acceso para que pueda ofrecerla. Las claves nunca salen de Mosaic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic indique au système le site web et le nom d’utilisateur de chaque clé d’accès pour qu’il puisse la proposer. Les clés ne quittent jamais Mosaic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic comunica al sistema il sito web e il nome utente di ogni passkey, così può proporla. Le chiavi non escono mai da Mosaic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic は、各パスキーのウェブサイトとユーザー名をシステムに伝え、提案できるようにします。キーが Mosaic の外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic이 각 패스키를 제안할 수 있도록 웹사이트와 사용자 이름을 시스템에 알려 줘요. 키는 Mosaic 밖으로 나가지 않아요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic vertelt het systeem de website en gebruikersnaam van elke passkey, zodat het die kan aanbieden. De sleutels verlaten Mosaic nooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic przekazuje systemowi witrynę i nazwę użytkownika każdego klucza dostępu, aby mógł go zaproponować. Same klucze nigdy nie opuszczają Mosaic."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mosaic informa ao sistema o site e o nome de usuário de cada chave de acesso para que ele possa oferecê-la. As chaves nunca saem do Mosaic."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic, sunabilmesi için sisteme her geçiş anahtarının web sitesini ve kullanıcı adını bildirir. Anahtarlar Mosaic’ten asla çıkmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic 会把每个通行密钥的网站和用户名告知系统，以便系统提供它。密钥本身绝不会离开 Mosaic。"
          }
        }
      }
    },
    "mobile.settings.passwordIdentities" : {
      "extractionState" : "manual",
      "localizations" : {
