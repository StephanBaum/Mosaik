        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic が入力するのは、このサイト用に保存されたログインのみです。Mosaic を開いて、このサイトをログインに追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
