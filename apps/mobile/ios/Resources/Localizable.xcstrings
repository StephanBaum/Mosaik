    "mobile.onboarding.details.keyWiped" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic hat den gescannten Secret Key entfernt, als du die App verlassen hast. Scanne den Code noch einmal oder tippe den Schlüssel ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic removed the scanned Secret Key when you left the app. Scan the code again or type the key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic eliminó la Clave secreta escaneada al salir de la app. Escanea el código de nuevo o escribe la clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic a supprimé la clé secrète scannée quand vous avez quitté l’application. Scannez de nouveau le code ou saisissez la clé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
