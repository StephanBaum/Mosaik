    "mobile.link.warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verknüpfe nur Apps, denen du vertraust. Mosaic kann nicht bestätigen, dass diese App zu %1$@ gehört."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only link apps you trust. Mosaic can't confirm this app belongs to %1$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincula solo apps en las que confíes. Mosaic no puede confirmar que esta app pertenezca a %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’associez que des applications de confiance. Mosaic ne peut pas confirmer que cette application appartient à %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega solo app di cui ti fidi. Mosaic non può confermare che questa app appartenga a %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼できるアプリのみをリンクしてください。このアプリが %1$@ に属していることを、Mosaic は確認できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신뢰하는 앱만 연결하세요. 이 앱이 %1$@에 속하는지 Mosaic이 확인할 수 없어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel alleen apps die je vertrouwt. Mosaic kan niet bevestigen dat deze app bij %1$@ hoort."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiązuj tylko aplikacje, którym ufasz. Mosaic nie może potwierdzić, że ta aplikacja należy do %1$@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só vincule apps em que você confia. O Mosaic não consegue confirmar que este app pertence a %1$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca güvendiğiniz uygulamaları bağlayın. Mosaic bu uygulamanın %1$@ sitesine ait olduğunu doğrulayamaz."
          }
