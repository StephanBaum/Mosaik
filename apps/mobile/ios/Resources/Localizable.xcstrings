          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mosaic ainda está concluindo a última etapa. Aguarde um momento e tente de novo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic hâlâ son adımı bitiriyor. Biraz bekleyin, sonra yeniden deneyin."
