    "error.folderServerTlsTooOld" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server ist für eine sichere Verbindung zu alt. Mosaic braucht TLS 1.3. Bitte die Person, die den Server betreibt, ihn zu aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server is too old for a secure connection. Mosaic needs TLS 1.3. Ask whoever runs the server to update it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor es demasiado antiguo para una conexión segura. Mosaic necesita TLS 1.3. Pide a quien administra el servidor que lo actualice."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur est trop ancien pour une connexion sécurisée. Mosaic exige TLS 1.3. Demandez à la personne qui exploite le serveur de le mettre à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo server è troppo vecchio per una connessione sicura. Mosaic richiede TLS 1.3. Chiedi a chi gestisce il server di aggiornarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバーは古すぎて、安全な接続ができません。Mosaic には TLS 1.3 が必要です。サーバーの運用者に更新を依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 서버는 보안 연결을 하기에는 너무 오래되었어요. Mosaic은 TLS 1.3이 필요해요. 서버 운영자에게 업데이트를 요청하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze server is te oud voor een beveiligde verbinding. Mosaic heeft TLS 1.3 nodig. Vraag degene die de server beheert om hem bij te werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten serwer jest zbyt stary dla bezpiecznego połączenia. Mosaic wymaga TLS 1.3. Poproś osobę zarządzającą serwerem o aktualizację."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor é antigo demais para uma conexão segura. O Mosaic exige TLS 1.3. Peça a quem administra o servidor que o atualize."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sunucu güvenli bağlantı için çok eski. Mosaic TLS 1.3 gerektirir. Sunucuyu işleten kişiden güncellemesini isteyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务器版本过旧，无法建立安全连接。Mosaic 需要 TLS 1.3。请联系服务器的运营者更新。"
          }
        }
      }
    },
