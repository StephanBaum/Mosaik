    "error.wrongCredentials" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Master-Passwort oder der Secret Key hat nicht funktioniert. Prüfe auf Tippfehler und die Tastatursprache und versuche es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That master password or Secret Key didn't work. Check for typos and the keyboard language, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa contraseña maestra o Clave secreta no funcionó. Revisa que no haya erratas ni un idioma de teclado distinto y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mot de passe principal ou cette clé secrète n’a pas fonctionné. Vérifiez les fautes de frappe et la langue du clavier, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password principale o la Chiave segreta non ha funzionato. Controlla eventuali errori di battitura e la lingua della tastiera, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マスターパスワードまたはシークレットキーが正しくありません。入力ミスやキーボードの言語を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마스터 비밀번호 또는 비밀 키가 올바르지 않아요. 오타와 키보드 언어를 확인한 다음 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat hoofdwachtwoord of die Geheime Sleutel werkte niet. Controleer op typefouten en de toetsenbordtaal en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasło główne lub Klucz tajny nie zadziałały. Sprawdź literówki i język klawiatury, a potem spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa senha mestra ou Chave Secreta não funcionou. Verifique erros de digitação e o idioma do teclado e tente de novo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ana parola veya Gizli Anahtar çalışmadı. Yazım hatalarını ve klavye dilini kontrol edin, sonra yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主密码或机密密钥不正确。请检查是否输错，以及键盘语言，然后重试。"
          }
        }
      }
    },
