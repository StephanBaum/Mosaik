          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic to oprogramowanie przed audytem. Nie przeprowadzono jeszcze niezależnego audytu bezpieczeństwa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
