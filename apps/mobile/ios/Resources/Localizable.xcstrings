          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni di Face ID sono cambiate. Sblocca con la password principale per riattivare lo sblocco rapido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID の設定が変更されました。クイックロック解除をもう一度オンにするには、マスターパスワードでロックを解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID 설정이 변경되었어요. 빠른 잠금 해제를 다시 켜려면 마스터 비밀번호로 잠금을 해제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Face ID-instellingen zijn gewijzigd. Ontgrendel met je hoofdwachtwoord om snel ontgrendelen weer aan te zetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia Face ID uległy zmianie. Odblokuj hasłem głównym, aby ponownie włączyć szybkie odblokowanie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As suas configurações do Face ID mudaram. Desbloqueie com a sua senha mestra para ativar o desbloqueio rápido de novo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
