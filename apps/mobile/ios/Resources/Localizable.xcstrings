          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwól Mosaic proponować Twoje logowania w innych aplikacjach i w przeglądarce. Możesz to później zmienić w ustawieniach systemu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe o Mosaic oferecer os seus logins em outros apps e no navegador. Você pode mudar isso depois nas configurações do sistema."
          }
        },
