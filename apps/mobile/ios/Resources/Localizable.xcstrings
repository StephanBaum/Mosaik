    "mobile.onboarding.welcome.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich bei deinem Mosaic-Konto an, um deine Passwörter hierher zu holen. Alles bleibt auf diesem Handy verschlüsselt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to your Mosaic account to bring your passwords here. Everything stays encrypted on this phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en tu cuenta de Mosaic para traer aquí tus contraseñas. Todo permanece cifrado en este teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à votre compte Mosaic pour y retrouver vos mots de passe. Tout reste chiffré sur ce téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi al tuo account Mosaic per portare qui le tue password. Tutto resta cifrato su questo telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic アカウントにサインインして、パスワードをここに持ってきます。すべての内容は、このスマートフォン上で暗号化されたままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mosaic 계정에 로그인해서 비밀번호를 가져오세요. 모든 내용은 이 휴대폰에서 암호화된 상태로 유지돼요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in op je Mosaic-account om je wachtwoorden hierheen te halen. Alles blijft versleuteld op deze telefoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się na konto Mosaic, aby przenieść tu swoje hasła. Wszystko pozostaje zaszyfrowane na tym telefonie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre na sua conta do Mosaic para trazer as suas senhas para cá. Tudo fica criptografado neste celular."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parolalarınızı buraya getirmek için Mosaic hesabınızda oturum açın. Her şey bu telefonda şifreli kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录你的 Mosaic 账户，把你的密码带到这里。所有内容都会在这部手机上保持加密。"
          }
        }
      }
    },
