    "mobile.onboarding.autofill.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Mosaic deine Logins in anderen Apps und im Browser anbieten. Das kannst du später in den Systemeinstellungen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let Mosaic offer your logins in other apps and in the browser. You can change this later in the system settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que Mosaic ofrezca tus inicios de sesión en otras apps y en el navegador. Puedes cambiarlo más tarde en los ajustes del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez Mosaic proposer vos identifiants dans d’autres applications et dans le navigateur. Vous pourrez le modifier plus tard dans les réglages du système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia che Mosaic proponga i tuoi accessi in altre app e nel browser. Puoi cambiarlo in seguito nelle impostazioni di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のアプリやブラウザで、Mosaic がログインを表示できるようにします。この設定は、後からシステム設定で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱과 브라우저에서 Mosaic이 로그인을 제안하게 해요. 나중에 시스템 설정에서 변경할 수 있어요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
