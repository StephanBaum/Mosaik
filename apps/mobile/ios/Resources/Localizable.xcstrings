    "mobile.setup.scanHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne auf deinem Computer Mosaic, geh in den Einstellungen zu Sync und wähle „Handy einrichten“. Halte die Kamera auf den Code."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On your computer, open Mosaic, go to Settings > Sync and choose “Set up a phone”. Hold the camera over the code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu equipo, abre Mosaic, ve a Ajustes > Sincronización y elige “Configurar un teléfono”. Apunta la cámara al código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur votre ordinateur, ouvrez Mosaic, allez dans Réglages > Synchronisation et choisissez « Configurer un téléphone ». Placez la caméra devant le code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul computer apri Mosaic, vai su Impostazioni > Sincronizzazione e scegli “Configura un telefono”. Inquadra il codice con la fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パソコンで Mosaic を開き、「設定」>「同期」で「スマートフォンを設定」を選びます。カメラをコードにかざしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터에서 Mosaic을 열고 설정 > 동기화로 이동해 “휴대폰 설정”을 선택하세요. 카메라를 코드에 갖다 대세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Mosaic op je computer, ga naar Instellingen > Synchronisatie en kies “Een telefoon instellen”. Houd de camera boven de code."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na komputerze otwórz Mosaic, przejdź do Ustawienia > Synchronizacja i wybierz „Skonfiguruj telefon”. Skieruj aparat na kod."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No seu computador, abra o Mosaic, vá em Configurações > Sincronização e escolha “Configurar um celular”. Aponte a câmera para o código."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayarınızda Mosaic’i açın, Ayarlar > Eşitleme’ye gidin ve “Telefon kur”u seçin. Kamerayı kodun üzerine tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你的电脑上打开 Mosaic，进入“设置 > 同步”，选择“设置手机”。然后把相机对准二维码。"
          }
        }
      }
    },
