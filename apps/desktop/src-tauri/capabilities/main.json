{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: Mosaic's own commands and nothing else (no core, shell, fs, http or dialog permission). See ADR-0019.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-session-state",
    "allow-create-account",
    "allow-save-emergency-kit",
    "allow-verify-emergency-kit",
    "allow-unlock",
    "allow-lock",
    "allow-reauthenticate",
    "allow-subscribe-events",
    "allow-app-status",
    "allow-unlock-quick",
    "allow-quick-unlock-status",
    "allow-enroll-biometric",
    "allow-remove-biometric",
    "allow-enroll-hardware-key",
    "allow-remove-hardware-key",
    "allow-hardware-key-cancel",
    "allow-list-vaults",
    "allow-create-vault",
    "allow-rename-vault",
    "allow-create-hardware-vault",
    "allow-open-hardware-vault",
    "allow-close-hardware-vault",
    "allow-hardware-vault-keys",
    "allow-add-hardware-vault-key",
    "allow-remove-hardware-vault-key",
    "allow-list-items",
    "allow-get-item",
    "allow-reveal-secret",
    "allow-add-item",
    "allow-update-item",
    "allow-set-favorite",
    "allow-trash-item",
    "allow-restore-item",
    "allow-purge-item",
    "allow-move-item",
    "allow-attachment-add",
    "allow-attachment-preview",
    "allow-attachment-save",
    "allow-attachment-remove",
    "allow-copy-to-clipboard",
    "allow-clear-clipboard",
    "allow-generate-password",
    "allow-totp-code",
    "allow-otp-scan",
    "allow-otp-parse",
    "allow-otp-pending-code",
    "allow-otp-pending-discard",
    "allow-get-settings",
    "allow-update-settings",
    "allow-security-report",
    "allow-import-choose-file",
    "allow-import-preview",
    "allow-import-commit",
    "allow-import-cancel",
    "allow-export-passkeys-cxf",
    "allow-ssh-agent-status",
    "allow-ssh-agent-set-enabled",
    "allow-ssh-respond",
    "allow-browser-status",
    "allow-browser-remove-pairing",
    "allow-browser-pairing-respond",
    "allow-browser-save-respond",
    "allow-browser-passkey-respond"
  ]
}
