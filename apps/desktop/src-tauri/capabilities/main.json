{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: Mosaic's own commands and nothing else (no core, shell, fs, http or dialog permission). See ADR-0019.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-session-state",
    "allow-create-account",
    "allow-verify-emergency-kit",
    "allow-unlock",
    "allow-unlock-quick",
    "allow-lock",
    "allow-subscribe-events",
    "allow-list-vaults",
    "allow-create-vault",
    "allow-rename-vault",
    "allow-list-items",
    "allow-get-item",
    "allow-reveal-secret",
    "allow-add-item",
    "allow-update-item",
    "allow-set-favorite",
    "allow-trash-item",
    "allow-restore-item",
    "allow-purge-item",
    "allow-move-item",
    "allow-copy-to-clipboard",
    "allow-clear-clipboard",
    "allow-generate-password",
    "allow-totp-code",
    "allow-get-settings",
    "allow-update-settings",
    "allow-security-report",
    "allow-import-choose-file",
    "allow-import-preview",
    "allow-import-commit",
    "allow-import-cancel",
    "allow-ssh-agent-status",
    "allow-ssh-agent-set-enabled",
    "allow-ssh-respond"
  ]
}
