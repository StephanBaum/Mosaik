# Rust
/target/
**/fuzz/target/
**/fuzz/corpus/
**/fuzz/artifacts/

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo

# Tauri (gen/ and the per-command permissions are regenerated by build.rs)
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/permissions/autogenerated/

# Playwright
apps/desktop/test-results/
apps/desktop/playwright-report/

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Local Claude Code settings and workflow worktrees (per developer)
.claude/settings.local.json
.claude/worktrees/

# Crash dumps (Git Bash on Windows writes *.stackdump into the cwd)
*.stackdump

# Never commit secrets or local vaults
*.env
.env*
*.mosaic-vault
