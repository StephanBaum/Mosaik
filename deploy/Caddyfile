# Caddy in front of mosaic-server: TLS 1.3 only, automatic certificates, and
# the client address in X-Forwarded-For (Caddy replaces a client-sent value).
{$MOSAIC_DOMAIN} {
	tls {
		protocols tls1.3
	}

	# Attachments are up to about 50 MiB of ciphertext.
	request_body {
		max_size 64MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy mosaic-server:8743
}
